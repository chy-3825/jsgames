{
  "name": "jsgames",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "test": "node --test",
    "test:syntax": "node scripts/syntax-check.js",
    "test:browser": "node scripts/browser-runtime-smoke.js",
    "test:browser:chromium": "node scripts/chromium-runtime-smoke.js",
    "test:performance": "node scripts/performance-smoke.js",
    "test:audit": "npm audit --omit=dev --audit-level=high",
    "test:lint": "eslint .",
    "test:type": "tsc -p tsconfig.check.json",
    "test:coverage": "c8 --reporter=text-summary --reporter=lcov --check-coverage --lines=60 --functions=60 --branches=45 --statements=60 npm test",
    "test:complexity": "node scripts/complexity-audit.js",
    "test:reports": "node scripts/report-audit.js",
    "test:release": "node scripts/release-audit.js",
    "test:deploy": "node scripts/deployment-smoke.js",
    "test:acceptance": "node scripts/acceptance-gate.js"
  },
  "dependencies": {
    "debug": "~2.6.9",
    "express": "~4.22.2",
    "three": "^0.185.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "c8": "^10.1.3",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "typescript": "^5.9.3"
  }
}
