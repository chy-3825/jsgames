[Unit]
Description=JSGames online tabletop lobby
After=network.target

[Service]
Type=simple
# Replace these three values for the target server before installation.
User=jsgames
Group=jsgames
WorkingDirectory=/opt/jsgames
Environment=NODE_ENV=production
Environment=PORT=3000
# Room state is process-local by default; do not run replicas until a durable
# room-store adapter and shared realtime routing have been accepted.
# Replace with the public HTTPS origin before enabling the service.
# Environment=JSGAMES_ALLOWED_ORIGINS=https://table.example
# Set true only when this process is reachable exclusively through the trusted Nginx proxy.
# Environment=JSGAMES_TRUST_PROXY=true
ExecStart=/usr/bin/node ./bin/www
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/jsgames

[Install]
WantedBy=multi-user.target
